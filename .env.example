# ==============================================================
# FenceAI - Industrial Safety & Virtual Perimeter Configuration
# Copy this file to .env and configure your credentials
# ==============================================================

# AI and Video Source (Laptop Webcam testing: 0 | CCTV RTSP: rtsp://user:pass@ip:554/stream)
CAMERA_SOURCE=0
CONFIDENCE_THRESHOLD=0.25
ALERT_COOLDOWN_SECONDS=10

# PPE Alerts Dispatch Toggle (true: email/SMS/Telegram/WhatsApp on violation | false: Monitor Only)
PPE_ALERTS_ENABLED=false

# Twilio Dispatch (SMS and Voice Calls)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_PHONE=+1234567890
TWILIO_TO_PHONE=+1234567890
PUBLIC_BASE_URL=http://localhost:8000

# Email Alerts (SMTP)
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_alerts_email@gmail.com
SENDER_PASSWORD=your_gmail_app_password
RECIPIENT_EMAIL=your_recipient_email@gmail.com
EMAIL_COOLDOWN_SECONDS=10

# Cloud PostgreSQL / Supabase Database URL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=your_meta_whatsapp_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
RECIPIENT_PHONE=your_whatsapp_phone_number_here

# 256-bit Cryptographic JWT Secret
JWT_SECRET=generate_a_secure_random_64_character_hex_string_here
